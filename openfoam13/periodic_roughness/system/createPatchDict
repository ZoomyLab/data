// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// OF13: build the rough wall patch directly from an inline face zone
// (thin box on the bottom boundary, x in [5,15]). Replaces the deprecated
// topoSet faceSet workflow; produces an identical bottom_rough patch.
pointSync false;
patches
(
    {
        name        bottom_rough;
        patchInfo   { type wall; }
        constructFrom zone;
        zone { type box; box (5 -1e-3 -1) (15 1e-3 1); }
    }
);

